# Copy to .env for local development. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://church:church@localhost:5433/church_cms

CELERY_BROKER_URL=redis://localhost:6379/0

# File storage (SeaweedFS from docker-compose). Leave S3_BUCKET empty to store files on disk.
S3_BUCKET=church-cms-dev
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=church-dev
S3_SECRET_KEY=church-dev-secret
